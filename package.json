{
  "name": "dsh-harness-jarvis",
  "version": "0.7.1",
  "description": "A floating desktop assistant for DSH Desktop — a particle orb for quick permission approvals and fast floating conversations.",
  "license": "MIT",
  "author": "zane",
  "keywords": [
    "deepseek", "dsh", "harness", "jarvis", "assistant",
    "agent", "approval", "voice", "tts", "orb",
    "floating-window", "desktop-assistant", "desktop-pet", "desktop-widget",
    "macos", "悬浮窗", "桌面助手", "桌面宠物"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroissanTTs/dsh-harness-jarvis.git"
  },
  "homepage": "https://github.com/CroissantTTs/dsh-harness-jarvis#readme",
  "bugs": {
    "url": "https://github.com/CroissantTTs/dsh-harness-jarvis/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/synth-edge.mjs",
    "scripts/readme-config.mjs",
    "docs/images",
    "docs/design"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "docs:config": "npm run build && node scripts/readme-config.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "node-edge-tts": "^1.2.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@types/node": "^20",
    "typescript": "^5.9.0"
  }
}
