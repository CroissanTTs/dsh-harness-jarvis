{
  "name": "dsh-harness-jarvis",
  "version": "0.1.0",
  "description": "A DSH Desktop plugin for coordinating managed sessions, approvals, spoken updates, and local memory.",
  "license": "MIT",
  "author": "zane",
  "keywords": [
    "deepseek", "dsh", "harness", "jarvis", "commander",
    "agent", "multi-session", "approval", "memory", "voice", "tts"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/synth-edge.mjs",
    "scripts/readme-config.mjs",
    "docs/images",
    "docs/superpowers/plans/2026-09-24-jarvis-backlog.md"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "docs:config": "npm run build && node scripts/readme-config.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "node-edge-tts": "^1.2.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@types/node": "^20",
    "typescript": "^5.9.0"
  }
}
